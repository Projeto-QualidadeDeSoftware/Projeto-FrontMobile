{
  "expo": {
    "name": "Prontê",
    "slug": "pronte-mobile",
    "version": "1.0.1",
    "icon": "./assets/pronte-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.pronte.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/pronte-adaptive-icon.png",
        "backgroundColor": "#FFF4E6"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {},
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF4E6",
          "image": "./assets/pronte-splash.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1958c7ff-e426-4a12-afe5-eefdfb7f3198"
      }
    },
    "owner": "diegofariass-team"
  }
}
