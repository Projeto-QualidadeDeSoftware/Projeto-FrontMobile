# Produção. Este também é o endereço padrão quando não existe arquivo .env.
EXPO_PUBLIC_API_URL=https://api.20-151-6-104.sslip.io
EXPO_PUBLIC_MODO_DEMO=false

# Para homologação, use:
# EXPO_PUBLIC_API_URL=https://hml.20-151-6-104.sslip.io

# Para uma API executada no próprio computador, use no navegador:
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Celular físico com API local: troque pelo IPv4 do computador.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Android Emulator com API local:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Para testar todas as telas sem qualquer servidor, altere para true.
# EXPO_PUBLIC_MODO_DEMO=true
